---
import Layout from '../layouts/Layout.astro';
import SampleBanner from '../components/SampleBanner.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Seasons from '../components/Seasons.astro';
import Gallery from '../components/Gallery.astro';
import ServiceArea from '../components/ServiceArea.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Footer from '../components/Footer.astro';
import MobileCallBar from '../components/MobileCallBar.astro';
---

<Layout>
  <SampleBanner />
  <Header />
  <main>
    <Hero />
    <Services />
    <Seasons />
    <Gallery />
    <ServiceArea />
    <QuoteForm />
  </main>
  <Footer />
  <MobileCallBar />
</Layout>
