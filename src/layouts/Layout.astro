---
import '../styles/global.css';
import { business } from '../config/business';
import { absoluteUrl } from '../lib/utils';
import { buildBusinessSchema, serializeJsonLd } from '../lib/schema';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = `${business.shortName} | Landscaping in ${business.address.city}, ${business.address.region}${business.demoMode ? ' (Sample site)' : ''}`,
  description = business.description,
} = Astro.props;

const canonical = absoluteUrl(Astro.url.pathname);
const ogImage = absoluteUrl(business.ogImage);
const jsonLd = serializeJsonLd(buildBusinessSchema());
const c = business.colors;
const brandVars = `--brand-primary:${c.primary};--brand-primary-contrast:${c.primaryContrast};--brand-ink:${c.ink};--brand-paper:${c.paper};--brand-surface:${c.surface};--brand-soft:${c.soft};`;
---

<!doctype html>
<html lang="en" style={brandVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={business.favicon} />
    <meta name="theme-color" content={c.paper} />
    <meta name="format-detection" content="telephone=no" />
    {business.demoMode && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.shortName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" as="image" href={business.hero.image.src} fetchpriority="high" />
    <!-- schema.org LocalBusiness generated from src/config/business.ts -->
    <script type="application/ld+json" is:inline set:html={jsonLd} />
  </head>
  <body>
    <slot />
  </body>
</html>
