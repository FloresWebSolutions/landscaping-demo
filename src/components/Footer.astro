---
import { business } from '../config/business';
import { telHref, mailHref } from '../lib/utils';
const year = new Date().getFullYear();
const attributed = business.imageCredits.filter((c) => c.license.startsWith('CC BY'));
const free = business.imageCredits.filter((c) => !c.license.startsWith('CC BY'));
---

<footer class="bg-ink text-paper">
  <div class="wrap grid gap-10 py-14 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <p class="font-display text-2xl font-bold">{business.shortName}</p>
      <p class="mt-3 max-w-xs text-[0.95rem] text-paper/75">{business.tagline}</p>
      <p class="mt-6 grid gap-1 text-[0.95rem]">
        <a href={telHref} class="text-paper no-underline hover:underline tabular-nums">{business.phone}</a>
        <a href={mailHref} class="text-paper no-underline hover:underline">{business.email}</a>
      </p>
    </div>
    <div class="text-sm text-paper/75 lg:col-span-8">
      <p class="font-semibold text-paper">Photo credits</p>
      <ul class="mt-3 grid gap-1.5 sm:grid-cols-2">
        {attributed.map((c) => (
          <li>
            <a href={c.sourceUrl} class="text-paper/90 underline-offset-2 hover:underline" rel="noopener">{c.title}</a> by {c.author},{' '}
            <a href={c.licenseUrl} class="text-paper/90 hover:underline" rel="license noopener">{c.license}</a>
          </li>
        ))}
      </ul>
      <p class="mt-3">
        Also used, no attribution required: {free.map((c, i) => (<><a href={c.sourceUrl} class="text-paper/90 hover:underline" rel="noopener">{c.title}</a>{` (${c.license})`}{i < free.length - 1 ? '; ' : '. '}</>))}
        Photos cropped and resized. Full list in IMAGE_CREDITS.md.
      </p>
    </div>
  </div>
  <div class="wrap flex flex-col gap-2 border-t border-paper/15 py-6 text-sm text-paper/70 sm:flex-row sm:justify-between">
    <p>© {year} {business.shortName}. {business.demoMode && 'Fictional sample business.'}</p>
    <p>Website demo by <a href="https://mavrickweb.com" class="text-paper hover:underline">SVK</a></p>
  </div>
</footer>
