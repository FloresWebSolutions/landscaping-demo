---
import { business } from '../config/business';
import { telHref } from '../lib/utils';
import Icon from './Icon.astro';
---

<!-- Sticky click-to-call bar, mobile only. Sticky (not fixed) as the last element of <body>,
     so it settles below the footer at the end and never covers content. -->
<div
  data-call-bar
  class="sticky bottom-0 z-50 border-t border-ink/10 bg-surface px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] shadow-[0_-10px_24px_-14px_rgb(24_38_29/0.4)] lg:hidden"
>
  <div class="flex gap-3">
    <a href={telHref} class="btn-primary flex-1" aria-label={`Call ${business.shortName} at ${business.phone}`}><Icon name="phone" /> Call now</a>
    <a href="#quote" class="btn-quiet flex-1">Get a quote</a>
  </div>
</div>
