---
import { business } from '../config/business';
const seasonsData = JSON.stringify(business.seasons.map((s) => ({ key: s.key, months: s.months })));
---

<section id="seasons" class="bg-ink text-paper">
  <div class="wrap py-16 lg:py-24">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <h2 class="text-4xl font-semibold sm:text-5xl lg:col-span-6">A garden year, planned ahead.</h2>
      <p class="max-w-xl text-paper/80 lg:col-span-5 lg:col-start-8">
        Care plans follow the seasons, not a fixed checklist. Here is what our crews are busy with through the year.
      </p>
    </div>
    <div class="mt-12 grid gap-px overflow-hidden rounded-[14px] bg-paper/15 sm:grid-cols-2 lg:grid-cols-4">
      {
        business.seasons.map((s) => (
          <article data-season={s.key} class="group bg-ink p-6 transition-colors duration-300 data-[current]:bg-soft data-[current]:text-ink lg:p-8">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="text-2xl font-semibold">{s.name}</h3>
              <span class="hidden rounded-sm bg-brand px-2 py-0.5 text-xs font-semibold text-brand-contrast group-data-[current]:inline">Now</span>
            </div>
            <p class="mt-3 font-medium text-paper/90 group-data-[current]:text-ink/90">{s.focus}</p>
            <ul class="mt-5 grid gap-2 text-[0.95rem] text-paper/75 group-data-[current]:text-ink/80">
              {s.tasks.map((t) => <li>{t}</li>)}
            </ul>
          </article>
        ))
      }
    </div>
    <p class="mt-8 max-w-2xl text-[0.95rem] text-paper/75">
      Care plans start at $160 a month and include every visit on this calendar for your property.
    </p>
  </div>
</section>

<script is:inline define:vars={{ seasonsData }}>
  (function () {
    var m = new Date().getMonth() + 1;
    var cur = JSON.parse(seasonsData).find(function (s) { return s.months.indexOf(m) !== -1; });
    if (cur) {
      var el = document.querySelector('[data-season="' + cur.key + '"]');
      if (el) el.setAttribute('data-current', '');
    }
  })();
</script>
