---
import { business, FORMSPREE_PLACEHOLDER } from '../config/business';
import { formspreeAction, formspreeConfigured, telHref, mailHref } from '../lib/utils';
import Icon from './Icon.astro';
const { quote } = business;
---

<section id="quote" class="py-16 lg:py-24">
  <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <h2 class="section-title">{quote.title}</h2>
      <p class="mt-5 max-w-md text-ink/80">{quote.lede}</p>
      <div class="mt-8 grid gap-3 text-[0.95rem]">
        <a href={telHref} class="flex min-h-11 items-center gap-3 font-semibold no-underline hover:text-brand tabular-nums"><Icon name="phone" class="size-5 text-brand" />{business.phone}</a>
        <a href={mailHref} class="flex min-h-11 items-center gap-3 font-semibold no-underline hover:text-brand"><Icon name="envelope-simple" class="size-5 text-brand" />{business.email}</a>
      </div>
    </div>

    <div class="lg:col-span-8">
      {
        !formspreeConfigured && (
          <p class="mb-6 rounded-md bg-soft px-4 py-3 text-[0.95rem]" role="note">
            <strong>Demo form.</strong> Submissions are switched off until a Formspree form ID is set as{' '}
            <code class="text-sm">formspreeId</code> in <code class="text-sm">src/config/business.ts</code>.
          </p>
        )
      }
      <form
        action={formspreeAction}
        method="POST"
        class="grid gap-x-5 gap-y-6 sm:grid-cols-2"
        data-formspree-placeholder={formspreeConfigured ? undefined : FORMSPREE_PLACEHOLDER}
      >
        <input type="hidden" name="_subject" value={`New quote request for ${business.shortName}`} />
        <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <label class="grid gap-2 font-medium">Name<input class="field" type="text" name="name" autocomplete="name" required /></label>
        <label class="grid gap-2 font-medium">Phone<input class="field" type="tel" name="phone" autocomplete="tel" required /></label>
        <label class="grid gap-2 font-medium">Email<input class="field" type="email" name="email" autocomplete="email" required /></label>
        <label class="grid gap-2 font-medium">Town
          <select class="field" name="town" required>
            <option value="">Choose your town</option>
            {business.serviceArea.towns.map((t) => <option>{t}</option>)}
            <option>Somewhere else</option>
          </select>
        </label>

        <fieldset class="sm:col-span-2">
          <legend class="font-medium">What do you need help with?</legend>
          <div class="mt-3 grid gap-2 sm:grid-cols-2">
            {business.services.map((s) => (
              <label class="flex min-h-11 cursor-pointer items-center gap-3 rounded-md border border-ink/20 bg-surface px-3.5 py-2.5 transition has-[:checked]:border-brand has-[:checked]:bg-soft">
                <input type="checkbox" name="services" value={s.name} class="size-4.5" />
                {s.name}
              </label>
            ))}
          </div>
        </fieldset>

        <label class="grid gap-2 font-medium">Property size
          <select class="field" name="property_size">
            {quote.propertySizes.map((p) => <option>{p}</option>)}
          </select>
        </label>
        <label class="grid gap-2 font-medium">Timeline
          <select class="field" name="timeline">
            {quote.timelines.map((t) => <option>{t}</option>)}
          </select>
        </label>
        <label class="grid gap-2 font-medium sm:col-span-2">
          <span>Tell us about the project <span class="font-normal text-ink/70">(optional)</span></span>
          <textarea class="field min-h-32" name="message" rows="4" placeholder="For example: the back lawn floods every winter and we would like a patio near the kitchen door."></textarea>
        </label>
        <div class="flex flex-col gap-4 sm:col-span-2 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-sm text-ink/75">We only use your details to reply to this request.</p>
          <button type="submit" class="btn-primary px-7 disabled:cursor-not-allowed disabled:bg-ink/65" disabled={!formspreeConfigured}>
            Send request <Icon name="paper-plane-tilt" />
          </button>
        </div>
      </form>
    </div>
  </div>
</section>
