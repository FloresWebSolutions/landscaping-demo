---
// Phosphor icons (regular weight), inlined at build time from @phosphor-icons/core.
const svgs = import.meta.glob('/node_modules/@phosphor-icons/core/assets/regular/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

interface Props {
  name: string;
  class?: string;
}
const { name, class: cls = 'size-5' } = Astro.props;
const raw = svgs[`/node_modules/@phosphor-icons/core/assets/regular/${name}.svg`];
if (!raw) throw new Error(`Unknown Phosphor icon: ${name}`);
const svg = raw.replace('<svg ', `<svg aria-hidden="true" focusable="false" class="${cls}" fill="currentColor" `);
---

<Fragment set:html={svg} />
