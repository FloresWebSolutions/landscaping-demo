---
import { business } from '../config/business';
import { DAYS, formatRanges, mapEmbedSrc, telHref } from '../lib/utils';
import Icon from './Icon.astro';
const { serviceArea: area } = business;
// Collapse Mon-Fri when identical.
const wk = DAYS.slice(0, 5).map((d) => formatRanges(business.officeHours[d.key]));
const weekdaysSame = wk.every((v) => v === wk[0]);
const rows = weekdaysSame
  ? [
      { label: 'Monday to Friday', value: wk[0] },
      ...DAYS.slice(5).map((d) => ({ label: d.label, value: formatRanges(business.officeHours[d.key]) })),
    ]
  : DAYS.map((d) => ({ label: d.label, value: formatRanges(business.officeHours[d.key]) }));
---

<section id="area" class="border-t border-ink/10 bg-surface">
  <div class="wrap grid gap-12 py-16 lg:grid-cols-12 lg:gap-16 lg:py-24">
    <div class="lg:col-span-5">
      <h2 class="section-title">Where we work</h2>
      <p class="mt-5 max-w-md text-ink/80">
        Based in {business.address.city}, we cover homes within about {area.radiusMiles} miles, including:
      </p>
      <ul class="mt-6 grid grid-cols-2 gap-x-6 gap-y-2.5 font-medium">
        {area.towns.map((t) => <li class="flex items-center gap-2"><Icon name="map-pin" class="size-4 shrink-0 text-brand" />{t}</li>)}
      </ul>
      <p class="mt-6 max-w-md text-[0.95rem] text-ink/75">{area.note}</p>

      <h3 class="mt-12 text-xl font-semibold">Office hours</h3>
      <dl class="mt-4 grid max-w-sm grid-cols-[1fr_auto] gap-x-6 gap-y-2 text-[0.95rem] tabular-nums">
        {rows.map((r) => (<><dt class="text-ink/80">{r.label}</dt><dd class:list={['text-right', r.value === 'Closed' ? 'text-ink/70' : 'font-medium']}>{r.value}</dd></>))}
      </dl>
      <p class="mt-4 text-[0.95rem] text-ink/75">
        Storm damage outside these hours? <a href={telHref} class="font-semibold text-brand underline">Call {business.phone}</a>.
      </p>
    </div>

    <div class="lg:col-span-7">
      {
        mapEmbedSrc ? (
          <iframe
            src={mapEmbedSrc}
            title={`Map of the ${business.shortName} service area`}
            class="block aspect-[4/3] w-full rounded-[14px] border-0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          />
        ) : (
          <div class="flex aspect-[4/3] w-full flex-col items-center justify-center gap-3 rounded-[14px] border border-dashed border-ink/30 bg-paper p-8 text-center">
            <Icon name="map-trifold" class="size-10 text-brand" />
            <p class="font-display text-xl font-semibold">Map slot</p>
            <p class="max-w-sm text-[0.95rem] text-ink/75">
              Add a Google Maps embed URL or search query to <code class="rounded bg-soft px-1.5 py-0.5 text-sm">googleMaps</code> in
              <code class="rounded bg-soft px-1.5 py-0.5 text-sm">src/config/business.ts</code> to show the live map here.
            </p>
          </div>
        )
      }
      <address class="mt-5 flex items-start gap-2.5 text-[0.95rem] text-ink/80 not-italic">
        <Icon name="warehouse" class="mt-0.5 size-5 shrink-0 text-brand" />
        <span>Yard and office: {business.address.street}, {business.address.city}, {business.address.region} {business.address.postalCode}</span>
      </address>
    </div>
  </div>
</section>
